

# Application Settings
APP_NAME="Dollar Factory Alternative"
APP_ENV=development
DEBUG=true
PORT=8000

# PostgreSQL Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=deriv_db
POSTGRES_USER=deriv_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_MIN_POOL_SIZE=2
POSTGRES_MAX_POOL_SIZE=10

# Deriv Market Data
API_TOKEN=replace_with_a_deriv_token
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_SYMBOLS=1HZ100V,R_100
DERIV_RECONNECT_DELAY_SECONDS=2
DERIV_BATCH_SIZE=500
DERIV_FLUSH_INTERVAL_SECONDS=0.5

# Deriv OAuth2
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_REDIRECT_URI=http://localhost:8000/auth/deriv/callback
DERIV_OAUTH_SCOPE=trade
DERIV_OAUTH_AUTH_URL=https://auth.deriv.com/oauth2/auth
DERIV_OAUTH_TOKEN_URL=https://auth.deriv.com/oauth2/token

# Platform Authentication
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15

# Data Encryption (AES-256-GCM)
DATA_ENCRYPTION_KEY=replace_with_a_32_byte_key_in_base64

# Email Verification
EMAIL_VERIFICATION_TOKEN_MINUTES=1440